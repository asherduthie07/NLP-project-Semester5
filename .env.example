# Development credentials only. Bind services to loopback; set a key before sharing.
CODEATLAS_DATABASE_URL=postgresql+psycopg://codeatlas:codeatlas@127.0.0.1:55433/codeatlas
CODEATLAS_REDIS_URL=redis://127.0.0.1:56380/0
CODEATLAS_STORAGE_ROOT=storage/artifacts
CODEATLAS_JOB_MODE=celery
CODEATLAS_API_KEY=
CODEATLAS_MAX_FILES=500
CODEATLAS_MAX_FILE_BYTES=2097152
CODEATLAS_MAX_TOTAL_BYTES=20971520
CODEATLAS_MAX_DOWNLOAD_BYTES=26214400
CODEATLAS_MAX_REQUEST_BYTES=29360128
CODEATLAS_MAX_ARCHIVE_RATIO=200
CODEATLAS_MAX_TOKENS_PER_FILE=100000
CODEATLAS_NETWORK_TIMEOUT_SECONDS=15
POSTGRES_PASSWORD=codeatlas

# Host ports only; container-to-container connections retain standard ports.
CODEATLAS_POSTGRES_PORT=55433
CODEATLAS_REDIS_PORT=56380
